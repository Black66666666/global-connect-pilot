{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "global-connect-pilot",
  "main": "src/main.py",
  "compatibility_date": "2026-09-27",
  "compatibility_flags": ["python_workers"],
  "d1_databases": [
    {
      "binding": "DB"
    }
  ],
  "observability": {
    "enabled": true
  }
}
