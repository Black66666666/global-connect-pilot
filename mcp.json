{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "global-connect": {
      "type": "streamable-http",
      "url": "https://global-connect.specforge.ru/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "global-connect-chatgpt",
              "tokenEndpointAuthMethod": "none"
            },
            "authorizationUrl": "https://global-connect.specforge.ru/oauth/authorize",
            "tokenUrl": "https://global-connect.specforge.ru/oauth/token",
            "authorizationServerBase": "https://global-connect.specforge.ru",
            "resource": "https://global-connect.specforge.ru",
            "baseScopes": [
              "reddit.identity",
              "reddit.read",
              "reddit.write"
            ]
          }
        }
      }
    }
  }
}
